@page "/surveys"
@inject SurveyAdminService Service

<PageTitle>アンケート一覧</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="h3 mb-0">アンケート</h1>
    <a class="btn btn-primary ms-auto" href="surveys/new">新規作成</a>
</div>

@if (surveys is null)
{
    <p>読み込み中…</p>
}
else if (surveys.Count == 0)
{
    <p class="text-muted">まだアンケートがありません。「新規作成」から作成してください。</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>タイトル</th>
                <th>状態</th>
                <th>締め切り</th>
                <th class="text-end">質問数</th>
                <th class="text-end">回答数</th>
                <th>更新日時</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var survey in surveys)
            {
                <tr>
                    <td><a href="surveys/@survey.Id">@survey.Title</a></td>
                    <td><span class="badge @SurveyLabels.StatusBadgeClass(survey.Status)">@SurveyLabels.Status(survey.Status)</span></td>
                    <td>@SurveyLabels.DateTime(survey.ClosesAt)</td>
                    <td class="text-end">@survey.QuestionCount</td>
                    <td class="text-end">@survey.ResponseCount</td>
                    <td>@SurveyLabels.DateTime(survey.UpdatedAt)</td>
                    <td class="text-end">
                        @if (survey.Status != SurveyStatus.Draft)
                        {
                            <a class="btn btn-sm btn-outline-primary" href="surveys/@survey.Id/results">結果</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SurveySummary>? surveys;

    protected override async Task OnInitializedAsync()
    {
        surveys = await Service.ListAsync();
    }
}
